# Dependencies
node_modules/

# Build output
build/
dist/
out/
.cache/

# Environment / secrets
.env*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor folders
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc

# Logs
logs/
*.log
!prototype/simulation/*.log
!docs/playtest/rolls.log

# Test coverage
coverage/
.nyc_output/

# art/source is NOT ignored: working files are tracked.
# Large binaries in art/source may later move to Git LFS.

# TypeScript build info / declaration output (tsc -b)
.tsbuild/
*.tsbuildinfo

# Claude Code agent worktrees and personal local settings (.claude/** is otherwise tracked, claudeOnly)
.claude/worktrees/
.claude/settings.local.json
